# ---------------------------------------------------------------------------
# ORTAK
# ---------------------------------------------------------------------------
# Webhook'larin disaridan erisilebilir adresi (ngrok / cloudflared / sunucu URL'i)
# Ornek: https://abcd-1234.ngrok-free.app
PUBLIC_URL=

# Test icin kendi cep telefonun (E.164 formatinda, +90 ile)
MY_TEST_NUMBER=+905XXXXXXXXX

# Ajanin arayan tarafta gorunecek numarasi = TR operatorunden aldigin DID
# Ornek: +908502222222  veya  +902122222222
TR_DID_NUMBER=+90850XXXXXXX

# LLM modeli (Vapi/Retell panelinde hesabinda acik olan model adiyla ayni olmali)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# TR SIP TRUNK (Verimor / Netgsm / Telesis / Bulutfon / Turk Telekom vb.)
# Operator sana bunlari verir. IP tabanli yetkilendirme yerine
# kullanici adi + sifre (SIP digest) tercih et.
# ---------------------------------------------------------------------------
SIP_GATEWAY_HOST=sip.operatorun.com.tr
SIP_GATEWAY_PORT=5060
SIP_USERNAME=
SIP_PASSWORD=
# Bazi operatorler ayri bir realm/domain ister; yoksa bos birak
SIP_REALM=

# ---------------------------------------------------------------------------
# VAPI
# ---------------------------------------------------------------------------
VAPI_API_KEY=
VAPI_BASE_URL=https://api.vapi.ai
# Vapi -> webhook cagrilarinda x-vapi-secret basligiyla gonderilir
VAPI_SERVER_SECRET=degistir-beni

# vapi:setup ciktisindan doldurulur
VAPI_CREDENTIAL_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# ---------------------------------------------------------------------------
# RETELL
# ---------------------------------------------------------------------------
RETELL_API_KEY=
RETELL_BASE_URL=https://api.retellai.com
# Retell'e trunk'i tanitirken kullanilan termination URI (operatorunden alinir)
RETELL_TERMINATION_URI=

# retell:setup ciktisindan doldurulur
RETELL_LLM_ID=
RETELL_AGENT_ID=

# ---------------------------------------------------------------------------
# SES (TTS) — Turkce icin
# ---------------------------------------------------------------------------
# Vapi tarafinda ElevenLabs sesi kullanacaksan voice id'yi buraya yaz
ELEVENLABS_VOICE_ID=
# Retell tarafinda kullanilacak ses (or. 11labs-Adrian veya Retell panelindeki bir TR ses)
RETELL_VOICE_ID=11labs-Adrian

PORT=3000

# Gelistirme sirasinda Retell imza dogrulamasini kapatmak icin false yap
RETELL_VERIFY_SIGNATURE=true
# Outbound testlerinde prompt'a gecirilen ornek degisken
TEST_CUSTOMER_NAME=
